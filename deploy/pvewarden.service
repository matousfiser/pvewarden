[Unit]
Description=pvewarden MCP server (agent-safe patching of Proxmox guests)
Documentation=https://github.com/matousfiser/pvewarden
# start after the network; a listen address that comes later (a VPN) is retried every 10 s
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pvewarden
Group=pvewarden
Environment=PVEWARDEN_CONFIG=/etc/pvewarden/config.toml
ExecStart=/opt/pvewarden/venv/bin/pvewarden serve --http
Restart=on-failure
RestartSec=10
# the server itself gives open client streams 5 s; never let a stop hang for systemd's 90 s
TimeoutStopSec=15

# hardening: the service can only write its state directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/pvewarden

[Install]
WantedBy=multi-user.target
