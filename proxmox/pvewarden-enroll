#!/bin/bash
# pvewarden-enroll — install/refresh the pvewarden client on guests. Run as root on the Proxmox host.
#   pvewarden-enroll [--pool] [--tags tag1,tag2] VMID...   install, optionally add to pool / merge tags
#   pvewarden-enroll --all                                 re-install on every guest in the pool
#   pvewarden-enroll --uninstall VMID...                   remove the client from guests
#   --auto-updates keep|off|on                             guests' own daily updates (default keep)
#   --dry-run (with any of the above)                      show what would change, change nothing
#
# Every guest gets its own SSH key, made on the server; the guest accepts only that key. Enrolling
# switches a guest in steps, each checked before the next: new key on the server -> added next to
# the old one in the guest -> the server logs in with it -> only the new key left in the guest ->
# the server makes it active. If a step fails, the switch does not happen; a guest left between
# steps is refused by the server until it is enrolled again.
set -euo pipefail

CONF=${PVEWARDEN_ENROLL_CONF:-/etc/pvewarden/enroll.conf}
GUEST_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../guest" && pwd)"
PVE_ETC=${PVE_ETC:-/etc/pve}
POOL=pvewarden
# shellcheck source=/dev/null
. "$CONF" # SERVER_CT= (or SERVER_CMD=), FROM=, optional POOL=
: "${FROM:?FROM missing in $CONF}"
[ -n "${SERVER_CT:-}${SERVER_CMD:-}" ] || {
  echo "SERVER_CT missing in $CONF (pvewarden 0.1.2 needs it: run pvewarden-setup upgrade)" >&2
  exit 1
}

# server ARGS...: run 'pvewarden ARGS' on the pvewarden server, as its service user
server() {
  if [ -n "${SERVER_CMD:-}" ]; then
    # shellcheck disable=SC2086  # SERVER_CMD is a command line, e.g. "ssh root@srv runuser -u pvewarden -- pvewarden"
    $SERVER_CMD "$@"
  else
    pct exec "$SERVER_CT" -- runuser -u pvewarden -- /usr/local/bin/pvewarden "$@"
  fi
}

usage() {
  sed -n '3,7s/^#  //p' "$0"
  exit 2
}

# Runs inside the guest as root: unpack the bundle from stdin and run install.sh with the given args.
# shellcheck disable=SC2016  # expanded inside the guest, not here
REMOTE='set -e
d=$(mktemp -d); trap "rm -rf $d" EXIT
base64 -d | tar -xz -C "$d"
"$d/guest/install.sh" "$@"'

# guest scripts as base64 tar, so they survive qm guest exec's text-only stdin
bundle() { tar -C "$GUEST_DIR/.." -cz guest | base64 -w0; }

guest_type() {
  if [ -f "$PVE_ETC/lxc/$1.conf" ]; then
    echo lxc
  elif [ -f "$PVE_ETC/qemu-server/$1.conf" ]; then
    echo qemu
  else
    echo "VMID $1 not found on this node" >&2
    return 1
  fi
}

pool_members() {
  pvesh get "/pools/$POOL" --output-format json |
    perl -MJSON::PP -e 'print "$_->{vmid}\n" for grep { defined $_->{vmid} } @{decode_json(join "", <STDIN>)->{members}}'
}

# run_lxc/run_qemu VMID ARGS... : run install.sh ARGS inside the guest
run_lxc() {
  local id=$1
  shift
  pct status "$id" | grep -q running || {
    echo "container $id is not running" >&2
    return 1
  }
  bundle | pct exec "$id" -- bash -c "$REMOTE" _ "$@"
}

run_qemu() {
  local id=$1
  shift
  qm status "$id" | grep -q running || {
    echo "VM $id is not running" >&2
    return 1
  }
  qm agent "$id" ping 2>/dev/null || {
    echo "VM $id: qemu-guest-agent not responding (install it, or run guest/install.sh by hand)" >&2
    return 1
  }
  # qm guest exec prints JSON; relay output and exit code
  bundle | qm guest exec "$id" --pass-stdin 1 --timeout 600 -- bash -c "$REMOTE" _ "$@" |
    perl -MJSON::PP -e '
      my $r = decode_json(join "", <STDIN>);
      print $r->{"out-data"} // ""; print STDERR $r->{"err-data"} // "";
      exit 124 unless $r->{exited};
      exit($r->{exitcode} // 1);'
}

add_to_pool() {
  local id=$1
  if pool_members | grep -qx "$id"; then
    echo "already in pool $POOL"
  elif [ "$DRY_RUN" = 1 ]; then
    echo "would: add to pool $POOL"
  else
    pveum pool modify "$POOL" --vms "$id" && echo "added to pool $POOL"
  fi
}

merge_tags() {
  local id=$1 type=$2 cmd current merged
  cmd=$([ "$type" = lxc ] && echo pct || echo qm)
  current=$($cmd config "$id" | sed -n 's/^tags: //p')
  # shellcheck disable=SC2086  # word splitting of tag lists is intended
  merged=$(printf '%s\n' ${current//;/ } ${TAGS//,/ } | sort -u | paste -sd';')
  if [ "$DRY_RUN" = 1 ]; then
    echo "would: set tags $merged"
  else
    $cmd set "$id" --tags "$merged" && echo "tags: $merged"
  fi
}

DO_POOL=0 TAGS="" UNINSTALL=0 DRY_RUN=0 AUTO=keep IDS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --pool) DO_POOL=1 ;;
    --tags)
      TAGS=${2:?--tags needs a value}
      shift
      ;;
    --all) mapfile -t IDS < <(pool_members) ;;
    --uninstall) UNINSTALL=1 ;;
    --auto-updates)
      AUTO=${2:-}
      case "$AUTO" in keep | off | on) ;; *) usage ;; esac
      shift
      ;;
    --dry-run) DRY_RUN=1 ;;
    -h | --help) usage ;;
    [0-9]*) IDS+=("$1") ;;
    *) usage ;;
  esac
  shift
done
[ ${#IDS[@]} -gt 0 ] || usage

OPTS=()
[ "$DRY_RUN" = 1 ] && OPTS+=(--dry-run)
[ "$AUTO" = keep ] || OPTS+=("--auto-updates=$AUTO")

# slow CMD...: prints a sign of life every 5 s while CMD runs (apt in a guest can take minutes)
slow() {
  local rc=0 ticker
  (
    n=0
    # sleep gets no inherited pipes: a killed ticker must not keep a caller waiting for EOF
    # shellcheck disable=SC2217  # stdin closed on purpose, see above
    while sleep "${PVEWARDEN_TICK:-5}" </dev/null >/dev/null 2>&1 3>&-; do
      n=$((n + ${PVEWARDEN_TICK:-5}))
      echo "    ... still working (${n}s)" >&2
    done
  ) &
  ticker=$!
  "$@" || rc=$?
  kill "$ticker" 2>/dev/null || true
  wait "$ticker" 2>/dev/null || true
  return "$rc"
}

# enroll_one VMID TYPE: install the client and switch the guest to its own key (see the top)
enroll_one() {
  local id=$1 type=$2 pub
  if [ "$DRY_RUN" = 1 ]; then
    slow "run_$type" "$id" "${OPTS[@]}" --keep-keys "ssh-ed25519 DRYRUN" "$FROM" || return 1
    [ "$DO_POOL" = 1 ] && add_to_pool "$id"
    echo "would: make a key for $id on the server, log in with it, leave only that key in the guest, activate it"
    [ -n "$TAGS" ] && merge_tags "$id" "$type"
    return 0
  fi
  pub=$(server key new "$id") || {
    echo "cannot make a key on the pvewarden server (is it running and up to date?)" >&2
    return 1
  }
  slow "run_$type" "$id" "${OPTS[@]}" --keep-keys "$pub" "$FROM" || return 1
  if [ "$DO_POOL" = 1 ]; then add_to_pool "$id" || return 1; fi
  server key verify "$id" || {
    echo "the server cannot log in to $id with its new key: nothing was switched (is $id in pool $POOL?)" >&2
    return 1
  }
  "run_$type" "$id" --keys-only "$pub" "$FROM" || {
    echo "could not remove the old key from $id: nothing was switched; run pvewarden-enroll $id again" >&2
    return 1
  }
  server key activate "$id" || {
    echo "$id accepts only its new key, but the server did not switch to it: run pvewarden-enroll $id again" >&2
    return 1
  }
  echo "own SSH key active"
  [ -n "$TAGS" ] && merge_tags "$id" "$type"
  return 0
}

uninstall_one() {
  local id=$1 type=$2
  slow "run_$type" "$id" "${OPTS[@]}" --uninstall || return 1
  if [ "$DRY_RUN" = 1 ]; then
    echo "would: delete the key for $id on the server"
  else
    server key remove "$id" || echo "note: could not delete the key for $id on the server" >&2
  fi
}

failed=()
for id in "${IDS[@]}"; do
  echo "=== $id"
  if ! type=$(guest_type "$id"); then
    failed+=("$id")
  elif [ "$UNINSTALL" = 1 ]; then
    uninstall_one "$id" "$type" || failed+=("$id")
  else
    enroll_one "$id" "$type" || failed+=("$id")
  fi
done

echo
if [ ${#failed[@]} -gt 0 ]; then
  echo "FAILED: ${failed[*]}"
  exit 1
fi
echo "OK: ${IDS[*]}"
