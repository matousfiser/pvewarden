#!/bin/bash
# pvewarden-setup — install, upgrade or remove pvewarden. Run as root on a Proxmox VE host.
#   pvewarden-setup [install|upgrade|enroll|connect|token|renew-cert|uninstall] [--yes] [--dry-run] [--source DIR|TARBALL]
#     no command      interactive menu
#     --yes           take defaults / PVEWARDEN_* environment variables instead of asking
#     --dry-run       show what would be done, change nothing
#     --source        use a local copy of pvewarden instead of downloading the release
#
# What install does on this host: a pool, a role with only the privileges pvewarden needs, an
# API user with a token granted only on that pool, an LXC running the server, and the
# pvewarden-enroll tool. The token secret goes straight into the container's config; it is
# never shown. Nothing here runs in the background afterwards.
# perl snippets for JSON parsing are deliberately single-quoted
# shellcheck disable=SC2016
set -euo pipefail

VERSION=0.1.2
REPO="${PVEWARDEN_REPO:-matousfiser/pvewarden}"
POOL=pvewarden
ROLE=Warden
PVE_USER=pvewarden@pve
TOKEN_NAME=server
HOST_DIR=${PVEWARDEN_HOST_DIR:-/opt/pvewarden}       # enroll tool and guest scripts on this host
ETC=${PVEWARDEN_HOST_ETC:-/etc/pvewarden}            # enroll.conf and setup state on this host
export PVEWARDEN_ENROLL_CONF=${PVEWARDEN_ENROLL_CONF:-$ETC/enroll.conf} # where pvewarden-enroll looks
SBIN=${PVEWARDEN_SBIN:-/usr/local/sbin}
CT_ETC=/etc/pvewarden                                # server config inside the container
PVE_ETC=${PVE_ETC:-/etc/pve}
SETUP_STATE=$ETC/setup.conf
OWNED=$ETC/owned.conf # Proxmox objects pvewarden-setup created (or was told to take over): uninstall deletes only these
TITLE="pvewarden $VERSION setup"
CT_TAG=pvewarden-server
TAG_UPDATE=pvewarden-update
TAG_REBOOT=pvewarden-reboot

DRY_RUN=0 YES=0 SOURCE="" COMMAND=""
WORK=$(mktemp -d)
CREATED_CT=""  # set once a container exists, so a failed install can say what it left behind
DIED=0         # die() has said why; any other non-zero exit is a step that failed
cleanup() {
  local rc=$?
  [ -z "$TICKER" ] || kill "$TICKER" 2>/dev/null || true
  rm -rf "$WORK"
  if [ "$rc" != 0 ] && [ "$DIED" = 0 ]; then
    echo "pvewarden-setup: a step failed (exit $rc); nothing after the output above was done." >&2
  fi
  if [ "$rc" != 0 ] && [ -n "$CREATED_CT" ]; then
    echo "pvewarden-setup: the install stopped; container $CREATED_CT was already created." >&2
    echo "  inspect it:  pct start $CREATED_CT --debug" >&2
    echo "  remove it:   pct stop $CREATED_CT; pct destroy $CREATED_CT --purge" >&2
  fi
}
trap cleanup EXIT

# ============================================================================================
# output and dialogs
# ============================================================================================

die() {
  echo "pvewarden-setup: $*" >&2
  DIED=1
  exit 1
}
info() { echo ">>> $*"; }

# Colors only on a terminal (https://no-color.org). Plain SGR codes: Windows conhost (cmd, ssh)
# shows them too. Commands meant for copying stay uncolored.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  C_HEAD=$'\e[1;36m' C_BOLD=$'\e[1m' C_OK=$'\e[1;32m' C_BAD=$'\e[1;31m' C_KEY=$'\e[1;33m' C_OFF=$'\e[0m'
else
  C_HEAD="" C_BOLD="" C_OK="" C_BAD="" C_KEY="" C_OFF=""
fi
WIDTH=78 # summaries fit an 80-column terminal; long commands start at column 0 and wrap cleanly
line() { printf '%s%s%s\n' "$C_HEAD" "$(printf "%${WIDTH}s" "" | tr ' ' "${1:-=}")" "$C_OFF"; }
# section TITLE: "--- TITLE -----", with an empty line around it
section() {
  local t="--- $1 "
  printf '\n%s%s%s%s\n\n' "$C_HEAD" "$t" "$(printf "%$((WIDTH - ${#t}))s" "" | tr ' ' -)" "$C_OFF"
}
# banner TEXT: a headline between two double lines
banner() {
  echo
  line '='
  printf ' %s\n' "$1"
  line '='
}
# field LABEL VALUE: one aligned "label  value" row
field() { printf ' %s%-10s%s %s\n' "$C_BOLD" "$1" "$C_OFF" "$2"; }
# run CMD...: execute, or only print in --dry-run mode
run() {
  if [ "$DRY_RUN" = 1 ]; then
    echo "would run: $*"
  else
    "$@"
  fi
}

# slow CMD...: like run, for steps that take a while. Prints a sign of life every 5 s, so a
# slow host does not look like a hung script. Via fd 3 (the original stderr): it also shows
# inside $(...) and when the command's own stderr is redirected.
exec 3>&2
TICKER=""
slow() {
  if [ "$DRY_RUN" = 1 ]; then
    run "$@"
    return
  fi
  local rc=0 start=$SECONDS took
  (
    n=0
    # sleep gets no inherited pipes: a killed ticker must not keep a caller waiting for EOF
    # shellcheck disable=SC2217  # stdin closed on purpose, see above
    while sleep "${PVEWARDEN_TICK:-5}" </dev/null >/dev/null 2>&1 3>&-; do
      n=$((n + ${PVEWARDEN_TICK:-5}))
      echo "    ... still working (${n}s)" >&3
    done
  ) &
  TICKER=$!
  "$@" || rc=$?
  kill "$TICKER" 2>/dev/null || true
  wait "$TICKER" 2>/dev/null || true
  TICKER=""
  took=$((SECONDS - start))
  [ "$took" -lt 3 ] || echo "    done (${took}s)" >&3
  return "$rc"
}

# Every question can be answered by an environment variable PVEWARDEN_<NAME>; with --yes the
# variable or the default is taken without asking.
env_or() {
  local name="PVEWARDEN_$1"
  printf '%s' "${!name:-$2}"
}

# ask NAME "question" default  ->  sets $NAME
ask() {
  local name=$1 question=$2 value
  value=$(env_or "$1" "$3")
  if [ "$YES" = 0 ]; then
    value=$(whiptail --title "$TITLE" --inputbox "$question" 12 76 "$value" 3>&1 1>&2 2>&3) || die "cancelled"
  fi
  printf -v "$name" '%s' "$value"
}

# ask_secret NAME "question"  ->  sets $NAME (asked twice, may be empty)
ask_secret() {
  local name=$1 question=$2 a b
  a=$(env_or "$1" "")
  if [ "$YES" = 0 ]; then
    while :; do
      a=$(whiptail --title "$TITLE" --passwordbox "$question" 10 76 3>&1 1>&2 2>&3) || die "cancelled"
      [ -z "$a" ] && break
      b=$(whiptail --title "$TITLE" --passwordbox "Repeat:" 8 76 3>&1 1>&2 2>&3) || die "cancelled"
      [ "$a" = "$b" ] && break
      whiptail --title "$TITLE" --msgbox "The two entries differ, try again." 8 60
    done
  fi
  printf -v "$name" '%s' "$a"
}

# choose NAME "question" default tag description [tag description ...]  ->  sets $NAME
choose() {
  local name=$1 question=$2 value
  value=$(env_or "$1" "$3")
  shift 3
  if [ "$YES" = 0 ]; then
    value=$(whiptail --title "$TITLE" --default-item "$value" --menu "$question" 20 76 10 "$@" 3>&1 1>&2 2>&3) ||
      die "cancelled"
  fi
  printf -v "$name" '%s' "$value"
}

# confirm "question"  ->  0 = yes
confirm() {
  [ "$YES" = 1 ] && return 0
  whiptail --title "$TITLE" --scrolltext --yesno "$1" 30 90
}

message() {
  if [ "$YES" = 1 ]; then echo "$1"; else whiptail --title "$TITLE" --msgbox "$1" 20 76; fi
}

json() { perl -MJSON::PP -e "my \$d = decode_json(join '', <STDIN>); $1"; }

# ============================================================================================
# host checks and discovery
# ============================================================================================

preflight() {
  [ "$(id -u)" = 0 ] || die "run as root"
  command -v pveversion >/dev/null || die "this is not a Proxmox VE host"
  PVE_MAJOR=$(pveversion | sed -n 's#^pve-manager/\([0-9]*\)\..*#\1#p')
  [ -n "$PVE_MAJOR" ] && [ "$PVE_MAJOR" -ge 8 ] || die "Proxmox VE 8 or newer is required"
  [ "$YES" = 1 ] || command -v whiptail >/dev/null || die "whiptail is missing (apt install whiptail)"
  # reading guest IPs through the qemu guest agent: renamed in PVE 9
  if [ "$PVE_MAJOR" -ge 9 ]; then AGENT_PRIV=VM.GuestAgent.Audit; else AGENT_PRIV=VM.Monitor; fi
  PRIVS="VM.Audit VM.Snapshot VM.Snapshot.Rollback VM.PowerMgmt $AGENT_PRIV"
  DEBIAN=$((PVE_MAJOR + 4)) # PVE 8 = Debian 12, PVE 9 = Debian 13
  NODE=$(hostname)
}

load_state() {
  CTID="" LISTEN="" CT_IP="" CT_HOSTNAME=pvewarden
  # shellcheck source=/dev/null
  [ -f "$SETUP_STATE" ] && . "$SETUP_STATE"
  return 0
}

save_state() {
  run mkdir -p "$ETC"
  if [ "$DRY_RUN" = 1 ]; then
    echo "would write $SETUP_STATE: CTID=$CTID LISTEN=$LISTEN CT_IP=$CT_IP CT_HOSTNAME=$CT_HOSTNAME"
  else
    printf 'CTID=%q\nLISTEN=%q\nCT_IP=%q\nCT_HOSTNAME=%q\nVERSION=%q\n' \
      "$CTID" "$LISTEN" "$CT_IP" "$CT_HOSTNAME" "$VERSION" > "$SETUP_STATE"
  fi
}

storages_for() { pvesm status --content "$1" 2>/dev/null | awk 'NR > 1 && $3 == "active" {print $1, $2}'; }
bridges() {
  local d
  for d in /sys/class/net/*/bridge; do [ -d "$d" ] && basename "$(dirname "$d")"; done
  return 0
}
host_ip_on() { ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1; }
default_gw() { ip -4 route show default 2>/dev/null | awk '{print $3; exit}'; }

# ============================================================================================
# source code: local copy or release download
# ============================================================================================

fetch_source() {
  SRC_TAR=$WORK/pvewarden.tar.gz
  local here
  here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
  if [ -z "$SOURCE" ] && [ -d "$here/.git" ] && [ -f "$here/pyproject.toml" ]; then
    # run from a git checkout: install exactly that code, not a release
    SOURCE=$here
    info "using the source tree this script runs from: $SOURCE"
  fi
  if [ -n "$SOURCE" ] && [ -d "$SOURCE" ]; then
    tar -C "$SOURCE" -czf "$SRC_TAR" --exclude .git --exclude .venv --exclude '__pycache__' --exclude config.toml .
  elif [ -n "$SOURCE" ]; then
    cp "$SOURCE" "$SRC_TAR"
  else
    local url="https://github.com/$REPO/releases/download/v$VERSION/pvewarden-$VERSION.tar.gz"
    info "downloading $url"
    curl -fsSL "$url" -o "$SRC_TAR" ||
      die "download failed: $url (is there a v$VERSION release? to install from a checkout: --source DIR)"
    curl -fsSL "$url.sha256" -o "$SRC_TAR.sha256" || die "checksum download failed"
    (cd "$WORK" && sed "s#  .*#  pvewarden.tar.gz#" pvewarden.tar.gz.sha256 | sha256sum -c --quiet) ||
      die "checksum mismatch: refusing to install"
  fi
  mkdir -p "$WORK/src"
  tar -C "$WORK/src" -xzf "$SRC_TAR"
  [ -f "$WORK/src/proxmox/pvewarden-enroll" ] || die "the source does not look like pvewarden"
}

# ============================================================================================
# install: questions
# ============================================================================================

ask_container() {
  local mode storages bridge_items=() b
  CTID=$(env_or CTID "$(pvesh get /cluster/nextid)")
  CT_HOSTNAME=pvewarden CORES=1 MEMORY=512 SWAP=512 DISK=4 VLAN="" IP6="" NAMESERVER="" SEARCHDOMAIN="" ONBOOT=1
  BRIDGE=$(bridges | head -1)
  ROOTFS_STORAGE=$(storages_for rootdir | awk '{print $1; exit}')
  TEMPLATE_STORAGE=$(storages_for vztmpl | awk '{print $1; exit}')
  [ -n "$ROOTFS_STORAGE" ] || die "no active storage can hold containers"
  [ -n "$TEMPLATE_STORAGE" ] || die "no active storage can hold container templates"

  choose MODE "The pvewarden server runs in its own small LXC container.\n\nDefault: Debian $DEBIAN, 1 core, 512 MB RAM, 4 GB disk, next free ID, first bridge.\nYou still choose the IP address, root password and SSH key.\n\nAdvanced: set every parameter." default \
    default "Default settings" advanced "Advanced settings"
  # shellcheck disable=SC2153  # set by choose
  mode=$MODE

  if [ "$mode" = advanced ]; then
    ask CTID "Container ID:" "$CTID"
    ask CT_HOSTNAME "Hostname:" "$CT_HOSTNAME"
    storages=()
    while read -r name type; do storages+=("$name" "$type"); done < <(storages_for rootdir)
    choose ROOTFS_STORAGE "Storage for the container disk (snapshots of the server itself need ZFS, LVM-thin or Ceph):" "$ROOTFS_STORAGE" "${storages[@]}"
    ask DISK "Disk size in GB:" "$DISK"
    ask CORES "CPU cores:" "$CORES"
    ask MEMORY "Memory in MB:" "$MEMORY"
    ask SWAP "Swap in MB:" "$SWAP"
    for b in $(bridges); do bridge_items+=("$b" "$(host_ip_on "$b")"); done
    choose BRIDGE "Network bridge:" "$BRIDGE" "${bridge_items[@]}"
    ask VLAN "VLAN tag (empty = none):" ""
  fi
  ask IP "IPv4 address with prefix for the container, e.g. 192.168.1.50/24, or 'dhcp'.\n\nA static address is recommended: agents connect to it and the HTTPS certificate is issued for it." "dhcp"
  GW=""
  if [ "$IP" != dhcp ]; then
    ask GW "IPv4 gateway:" "$(default_gw)"
  fi
  if [ "$mode" = advanced ]; then
    ask IP6 "IPv6: empty = none, 'auto' (SLAAC), 'dhcp', or address/prefix:" ""
    ask NAMESERVER "DNS servers, space separated (empty = same as this host):" ""
    ask SEARCHDOMAIN "DNS search domain (empty = same as this host):" ""
    choose ONBOOT "Start the container when the host boots?" 1 1 "Yes" 0 "No"
  fi

  ask_secret ROOT_PASSWORD "Root password for the container (min. 5 characters).\nEmpty = no password: use SSH keys or 'pct enter $CTID'."
  if [ -n "$ROOT_PASSWORD" ] && [ ${#ROOT_PASSWORD} -lt 5 ]; then die "the password must have at least 5 characters"; fi
  if [ "$YES" = 1 ]; then collect_ssh_keys "$(env_or SSH_KEYS "")"; else ssh_keys_dialog; fi

  pvesh get "/nodes/$NODE/lxc/$CTID/status/current" >/dev/null 2>&1 && die "ID $CTID is already in use"
  return 0
}

is_key() { case "$1" in ssh-* | ecdsa-* | sk-*) return 0 ;; *) return 1 ;; esac; }

# SSH public keys for root in the container. They get root, so every line is validated and the
# fingerprints are shown before anything is created. Collected into $SSH_KEYS_FILE.
SSH_KEYS_FILE="" SSH_KEYS_COUNT=0 SSH_KEYS_FROM="" SSH_KEYS_FPS="" KEY_ERROR=""

# add_keys SOURCE: gh:USER, gl:USER, https://URL, a file, or one pasted key. 1 + $KEY_ERROR on failure.
add_keys() {
  local src=$1 url="" new=$WORK/new_keys line fps="" n=0
  KEY_ERROR="" ADDED_FPS=""
  if is_key "$src"; then
    printf '%s\n' "$src" > "$new"
  else
    case "$src" in
      gh:?*) url="https://github.com/${src#gh:}.keys" ;;
      gl:?*) url="https://gitlab.com/${src#gl:}.keys" ;;
      https://*) url=$src ;;
      http://*) KEY_ERROR="refusing to fetch SSH keys over plain http: $src"; return 1 ;;
    esac
    if [ -n "$url" ]; then
      curl -fsSL --max-time 20 "$url" > "$new" 2>/dev/null || { KEY_ERROR="could not fetch SSH keys from $url"; return 1; }
    elif [ -f "$src" ]; then
      cat "$src" > "$new"
    else
      KEY_ERROR="not a key source (gh:USER, gl:USER, https://..., a file, or a pasted key): $src"
      return 1
    fi
  fi
  while IFS= read -r line; do
    case "$line" in "" | "#"*) continue ;; esac
    if ! is_key "$line"; then KEY_ERROR="not an SSH public key: ${line:0:60}"; return 1; fi
    printf '%s\n' "$line" > "$WORK/one.pub"
    fps+="$(ssh-keygen -lf "$WORK/one.pub" 2>/dev/null)"$'\n' || { KEY_ERROR="invalid SSH public key: ${line:0:60}"; return 1; }
    n=$((n + 1))
  done < "$new"
  if [ "$n" = 0 ]; then KEY_ERROR="no SSH public keys found${url:+ at $url}"; return 1; fi
  SSH_KEYS_FILE=$WORK/authorized_keys
  grep -v -e '^$' -e '^#' "$new" >> "$SSH_KEYS_FILE"
  SSH_KEYS_COUNT=$((SSH_KEYS_COUNT + n))
  is_key "$src" && src="pasted key"
  SSH_KEYS_FROM+="${SSH_KEYS_FROM:+, }$src"
  SSH_KEYS_FPS+=$fps
  ADDED_FPS=$fps
}

# --yes: PVEWARDEN_SSH_KEYS = sources separated by spaces, or one pasted key
collect_ssh_keys() {
  [ -n "$1" ] || return 0
  if is_key "$1"; then add_keys "$1" || die "$KEY_ERROR"; return 0; fi
  local src
  for src in $1; do add_keys "$src" || die "$KEY_ERROR"; done
}

ssh_keys_summary() {
  if [ "$SSH_KEYS_COUNT" = 0 ]; then echo "none"; return; fi
  printf '%s key(s) from %s\n' "$SSH_KEYS_COUNT" "$SSH_KEYS_FROM"
  printf '%s' "$SSH_KEYS_FPS" | sed 's/^/                       /'
}

# interactive: one source at a time, each with its own question and the result shown right away
ssh_keys_dialog() {
  local choice value prompt default=github status
  local host_keys=""
  [ -s /root/.ssh/authorized_keys ] && host_keys=/root/.ssh/authorized_keys
  while :; do
    if [ "$SSH_KEYS_COUNT" = 0 ]; then
      status="No keys added yet."
    else
      status="Added so far: $SSH_KEYS_COUNT key(s) from $SSH_KEYS_FROM"
    fi
    local items=(
      github "My GitHub account (keys published at github.com/USER.keys)"
      gitlab "My GitLab account (keys published at gitlab.com/USER.keys)"
      paste "Paste a public key (one line, starts with ssh-ed25519 or ssh-rsa)"
    )
    [ -n "$host_keys" ] && items+=(host "Keys that may log in to this Proxmox host as root")
    items+=(file "A file with public keys on this host" url "Another https:// address with keys")
    if [ "$SSH_KEYS_COUNT" = 0 ]; then
      items+=("done" "Continue without SSH keys (log in with the password or 'pct enter')")
    else
      items+=("done" "Done: use these $SSH_KEYS_COUNT key(s)")
    fi
    choice=$(whiptail --title "$TITLE" --default-item "$default" --menu \
      "Who may log in to the container as root over SSH?\n\n$status\n\nAdd keys from:" 22 82 8 \
      "${items[@]}" 3>&1 1>&2 2>&3) || die "cancelled"
    case "$choice" in
      done) return 0 ;;
      host) value=$host_keys ;;
      github | gitlab | paste | file | url)
        case "$choice" in
          github) prompt="Your GitHub user name, e.g. octocat\n\nThe public keys published at https://github.com/<name>.keys will be used." ;;
          gitlab) prompt="Your GitLab user name, e.g. alice\n\nThe public keys published at https://gitlab.com/<name>.keys will be used." ;;
          paste) prompt="Paste one public key (the content of e.g. ~/.ssh/id_ed25519.pub on your computer):\n\nssh-ed25519 AAAA... you@laptop" ;;
          file) prompt="Path to a file with public keys on this Proxmox host:" ;;
          url) prompt="https:// address that returns public keys, one per line:" ;;
        esac
        value=$(whiptail --title "$TITLE" --inputbox "$prompt" 14 82 3>&1 1>&2 2>&3) || continue
        value=$(printf '%s' "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -n "$value" ] || continue
        case "$choice" in github) value="gh:$value" ;; gitlab) value="gl:$value" ;; esac
        ;;
      *) continue ;;
    esac
    if add_keys "$value"; then
      whiptail --title "$TITLE" --msgbox "Added $(printf '%s' "$ADDED_FPS" | grep -c .) key(s):\n\n$ADDED_FPS\nCompare the fingerprints with your own keys: these keys get root in the container." 18 90
      default="done"
    else
      whiptail --title "$TITLE" --msgbox "$KEY_ERROR\n\nNothing was added. Try again or choose another source." 12 82
    fi
  done
}

ask_access() {
  choose ACCESS "How will agents reach the pvewarden server?" https \
    https "HTTPS on the container's address (certificate signed by the Proxmox CA)" \
    custom "My own address, e.g. a WireGuard/VPN IP I configure in the container myself"
  if [ "$ACCESS" = custom ]; then
    ask LISTEN "Address the server listens on (it must exist in the container before the server starts):" ""
    [ -n "$LISTEN" ] || die "an address is required"
    choose USE_TLS "Use HTTPS on that address too? (not needed inside an encrypted VPN)" no no "No, plain HTTP" yes "Yes, certificate signed by the Proxmox CA"
  else
    LISTEN="" USE_TLS=yes
  fi
  ask AGENT_NAME "Name of the first agent (shown in the audit log):" agent
}

summary() {
  cat <<EOF
Container
  ID / hostname        $CTID / $CT_HOSTNAME
  template             Debian $DEBIAN ($TEMPLATE_STORAGE)
  disk / cores / RAM   ${DISK} GB on $ROOTFS_STORAGE / $CORES / $MEMORY MB (+$SWAP MB swap)
  network              $BRIDGE${VLAN:+ vlan $VLAN}, IPv4 $IP${GW:+ via $GW}${IP6:+, IPv6 $IP6}
  DNS                  ${NAMESERVER:-as host}${SEARCHDOMAIN:+, search $SEARCHDOMAIN}
  root password        $([ -n "$ROOT_PASSWORD" ] && echo set || echo none)
  SSH keys             $(ssh_keys_summary)
  start on boot        $([ "$ONBOOT" = 1 ] && echo yes || echo no)
Server
  agents connect via   $([ "$USE_TLS" = yes ] && echo https || echo http)://${LISTEN:-<container IP>}:8765/mcp
Proxmox
  pool $POOL, role $ROLE ($PRIVS)
  user $PVE_USER, token $TOKEN_NAME granted only on /pool/$POOL
EOF
}

# ============================================================================================
# install: actions
# ============================================================================================

ensure_template() {
  [ "$DRY_RUN" = 1 ] || pveam update >/dev/null || true
  # the template index lists several architectures: a foreign one fails only at start ("Exec format error")
  local arch
  arch=$(dpkg --print-architecture)
  TEMPLATE=$(pveam available --section system | awk '{print $2}' | grep "^debian-$DEBIAN-standard_.*_$arch\.tar" |
    sort -V | tail -1 || true)
  [ -n "$TEMPLATE" ] || die "no Debian $DEBIAN template for $arch found in 'pveam available'"
  if ! pveam list "$TEMPLATE_STORAGE" | grep -q "$TEMPLATE"; then
    info "downloading template $TEMPLATE"
    slow pveam download "$TEMPLATE_STORAGE" "$TEMPLATE"
  fi
}

create_container() {
  local net="name=eth0,bridge=$BRIDGE,ip=$IP"
  [ -n "$GW" ] && net+=",gw=$GW"
  [ -n "$VLAN" ] && net+=",tag=$VLAN"
  [ -n "$IP6" ] && net+=",ip6=$IP6"
  local args=(
    --hostname "$CT_HOSTNAME" --cores "$CORES" --memory "$MEMORY" --swap "$SWAP"
    --rootfs "$ROOTFS_STORAGE:$DISK" --net0 "$net" --unprivileged 1 --features nesting=1
    --onboot "$ONBOOT" --tags "$CT_TAG" --description "pvewarden server (managed by pvewarden-setup)"
  )
  [ -n "$NAMESERVER" ] && args+=(--nameserver "$NAMESERVER")
  [ -n "$SEARCHDOMAIN" ] && args+=(--searchdomain "$SEARCHDOMAIN")
  [ -n "$SSH_KEYS_FILE" ] && args+=(--ssh-public-keys "$SSH_KEYS_FILE")
  info "creating container $CTID"
  slow pct create "$CTID" "$TEMPLATE_STORAGE:vztmpl/$TEMPLATE" "${args[@]}"
  [ "$DRY_RUN" = 1 ] || CREATED_CT=$CTID
  info "starting container $CTID"
  slow pct start "$CTID"
  if [ -n "$ROOT_PASSWORD" ]; then
    # via stdin: the password never appears in a process list or log
    if [ "$DRY_RUN" = 1 ]; then echo "would set the root password"; else
      printf 'root:%s\n' "$ROOT_PASSWORD" | pct exec "$CTID" -- chpasswd
    fi
  fi
}

wait_for_network() {
  [ "$DRY_RUN" = 1 ] && {
    CT_IP=${IP%/*}
    [ "$IP" = dhcp ] && CT_IP=192.0.2.1
    return 0
  }
  for _ in $(seq 60); do
    CT_IP=$(pct exec "$CTID" -- ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    if [ -n "$CT_IP" ] && pct exec "$CTID" -- getent hosts deb.debian.org >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  die "container $CTID has no working network (address: ${CT_IP:-none}); check the IP, gateway and DNS"
}

# --- ownership of the Proxmox objects -----------------------------------------------------

owns() { [ -f "$OWNED" ] && grep -qx "$1=1" "$OWNED"; }
mark_owned() {
  owns "$1" && return 0
  if [ "$DRY_RUN" = 1 ]; then echo "would record in $OWNED: $1"; return 0; fi
  mkdir -p "$ETC"
  echo "$1=1" >> "$OWNED"
}
# legacy_ownership: installs before 0.1.2 did not record whether they created the pool, role and
# user or took over existing ones without asking. Only the admin knows: record them as ours only
# when told (uninstall deletes what is recorded), and remember the answer.
legacy_ownership() {
  local adopt=no
  if [ "$YES" = 1 ]; then
    adopt=$(env_or ADOPT_EXISTING no)
  elif whiptail --title "$TITLE" --defaultno --yesno "pvewarden 0.1.1 and older did not record whether they created pool $POOL, role $ROLE and user $PVE_USER, or took over ones that already existed.\n\nDid pvewarden-setup create all three? Say yes only if none of them existed before you installed pvewarden: 'uninstall' will then delete them.\n\nNo (or unsure) = 'uninstall' leaves them and tells you how to remove them." 16 90; then
    adopt=yes
  fi
  if [ "$DRY_RUN" = 1 ]; then echo "would record in $OWNED: install before 0.1.2, created by pvewarden-setup: $adopt"; return 0; fi
  mkdir -p "$ETC"
  echo "# install before 0.1.2; the admin said pvewarden-setup created the pool, role and user: $adopt" > "$OWNED"
  if [ "$adopt" = yes ]; then
    mark_owned POOL
    mark_owned ROLE
    mark_owned USER
  fi
}
pool_exists() { pvesh get "/pools/$POOL" >/dev/null 2>&1; }
role_exists() { pveum role list --output-format json | json 'exit !grep { $_->{roleid} eq "'"$ROLE"'" } @$d'; }
user_exists() { pvesh get "/access/users/$PVE_USER" >/dev/null 2>&1; }

# check_name_collisions: before anything changes. A pool, role or user of the same name that
# pvewarden-setup did not create belongs to someone else: changing it (a role's privileges!) or
# deleting it at uninstall could break other things. Take it over only when told to.
check_name_collisions() {
  local found=() what
  pool_exists && ! owns POOL && found+=("pool $POOL (guests in it become visible to pvewarden)")
  role_exists && ! owns ROLE && found+=("role $ROLE (its privileges would be set to: $PRIVS; every user with this role gets exactly these)")
  user_exists && ! owns USER && found+=("user $PVE_USER (it gets a new API token)")
  [ ${#found[@]} -gt 0 ] || return 0
  what=$(printf -- '- %s\n' "${found[@]}")
  if [ "$YES" = 1 ]; then
    [ "$(env_or ADOPT_EXISTING no)" = yes ] ||
      die "Proxmox already has objects pvewarden-setup did not create; rename or remove them, or set PVEWARDEN_ADOPT_EXISTING=yes to take them over (uninstall then deletes them):"$'\n'"$what"
  else
    whiptail --title "$TITLE" --defaultno --yesno "Proxmox already has objects that pvewarden-setup did not create:\n\n$what\n\nTake them over? pvewarden will change them as described, and 'uninstall' will delete them.\n\nNo = stop here; nothing has been changed." 22 90 ||
      die "stopped: rename or remove the existing objects, then run the installer again"
  fi
  CLAIM_EXISTING=1
}

ensure_proxmox_access() {
  info "pool $POOL, role $ROLE, user $PVE_USER"
  if pool_exists; then
    [ "${CLAIM_EXISTING:-0}" = 1 ] || owns POOL || die "pool $POOL exists and was not created by pvewarden-setup"
  else
    run pveum pool add "$POOL" --comment "guests pvewarden may manage"
  fi
  mark_owned POOL
  if role_exists; then
    [ "${CLAIM_EXISTING:-0}" = 1 ] || owns ROLE || die "role $ROLE exists and was not created by pvewarden-setup"
    run pveum role modify "$ROLE" --privs "${PRIVS// /,}"
  else
    run pveum role add "$ROLE" --privs "${PRIVS// /,}"
  fi
  mark_owned ROLE
  if user_exists; then
    [ "${CLAIM_EXISTING:-0}" = 1 ] || owns USER || die "user $PVE_USER exists and was not created by pvewarden-setup"
  else
    run pveum user add "$PVE_USER" --comment "pvewarden (API only, no login)"
  fi
  mark_owned USER
  run pveum acl modify "/pool/$POOL" --users "$PVE_USER" --roles "$ROLE"
}

create_token() {
  if pvesh get "/access/users/$PVE_USER/token/$TOKEN_NAME" >/dev/null 2>&1; then
    run pveum user token remove "$PVE_USER" "$TOKEN_NAME"
  fi
  if [ "$DRY_RUN" = 1 ]; then
    echo "would run: pveum user token add $PVE_USER $TOKEN_NAME --privsep 0"
    TOKEN_SECRET=dry-run
    return 0
  fi
  TOKEN_SECRET=$(pveum user token add "$PVE_USER" "$TOKEN_NAME" --privsep 0 --output-format json | json 'print $d->{value}')
  [ -n "$TOKEN_SECRET" ] || die "token creation failed"
}

# API host name that matches the certificate, and how the container should verify it
api_endpoint() {
  local custom="$PVE_ETC/nodes/$NODE/pveproxy-ssl.pem"
  API_IP=$(host_ip_on "$BRIDGE")
  [ -n "$API_IP" ] || API_IP=$(hostname -I | awk '{print $1}')
  if [ -f "$custom" ]; then
    # custom (e.g. ACME) certificate: trusted by the system CAs, issued for this name
    API_HOST=$(openssl x509 -in "$custom" -noout -subject -nameopt multiline | sed -n 's/ *commonName *= //p')
    VERIFY=true
  else
    API_HOST=$NODE
    VERIFY="\"$CT_ETC/pve-root-ca.pem\""
  fi
}

ct_push() { # ct_push LOCALFILE REMOTEPATH MODE
  run pct push "$CTID" "$1" "$2" --perms "$3"
}

install_server() {
  info "installing the server in container $CTID (apt and pip: usually a few minutes)"
  run pct exec "$CTID" -- mkdir -p /root/pvewarden-src
  ct_push "$SRC_TAR" /root/pvewarden-src.tar.gz 0600
  run pct exec "$CTID" -- tar -C /root/pvewarden-src -xzf /root/pvewarden-src.tar.gz
  slow pct exec "$CTID" -- bash /root/pvewarden-src/deploy/install-server.sh "${LISTEN:-$CT_IP}"
  [ -n "$LISTEN" ] || LISTEN=$CT_IP
}

write_server_config() {
  local subnet agent_token
  # the container's own network: guests are expected there (python3 exists in the container now)
  if [ "$DRY_RUN" = 1 ]; then subnet="${CT_IP%.*}.0/24"; else
    subnet=$(pct exec "$CTID" -- sh -c "python3 -c 'import ipaddress,sys; print(ipaddress.ip_interface(sys.argv[1]).network)' \$(ip -4 -o addr show dev eth0 | awk '{print \$4; exit}')")
  fi
  agent_token=$(openssl rand -base64 33 | tr '+/' '-_' | tr -d '=\n')
  AGENT_TOKEN=$agent_token
  local tls_lines=""
  if [ "$USE_TLS" = yes ]; then
    tls_lines="tls_cert = \"$CT_ETC/tls.crt\"
tls_key = \"$CT_ETC/tls.key\"
tls_ca = \"$CT_ETC/tls-ca.pem\""
  fi
  umask 077
  cat > "$WORK/config.toml" <<EOF
# written by pvewarden-setup $VERSION
state_dir = "/var/lib/pvewarden"

[proxmox]
host = "$API_HOST"
port = 8006
token_id = "$PVE_USER!$TOKEN_NAME"
token_secret = "$TOKEN_SECRET"
verify_tls = $VERIFY

[ssh]
user = "pvewarden"
subnets = ["$subnet"]

[policy]
tag_update = "$TAG_UPDATE"
tag_reboot = "$TAG_REBOOT"

[http]
listen = "$LISTEN"
port = 8765
hostnames = ["$CT_HOSTNAME"]
$tls_lines

[http.clients]
$AGENT_NAME = "$agent_token"
EOF
  info "writing the server configuration (token secret goes only into the container)"
  ct_push "$WORK/config.toml" "$CT_ETC/config.toml" 0640
  rm -f "$WORK/config.toml"
  if [ "$VERIFY" != true ]; then ct_push "$PVE_ETC/pve-root-ca.pem" "$CT_ETC/pve-root-ca.pem" 0644; fi
  run pct exec "$CTID" -- chown root:pvewarden "$CT_ETC/config.toml"
  run pct exec "$CTID" -- sh -c "grep -q ' $API_HOST\$' /etc/hosts || echo '$API_IP $API_HOST' >> /etc/hosts"

  [ "$USE_TLS" != yes ] || issue_tls_cert
}

# The server's TLS certificate, signed by this cluster's Proxmox CA (/etc/pve/pve-root-ca.pem,
# the CA behind the web UI). A client that trusts that CA once keeps trusting pvewarden across
# reinstalls and renewed certificates. The private key is made in the container and never
# leaves it: only a CSR comes out and the signed certificate goes back. Without the CA key
# (unusual setups): self-signed.
PVE_CA_KEY=${PVE_CA_KEY:-$PVE_ETC/priv/pve-root-ca.key}
issue_tls_cert() {
  local san="IP:$LISTEN,DNS:$CT_HOSTNAME"
  if [ ! -r "$PVE_CA_KEY" ] && [ "$DRY_RUN" = 0 ]; then
    info "no Proxmox CA key ($PVE_CA_KEY): creating a self-signed certificate"
    run pct exec "$CTID" -- openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 1095 \
      -subj "/CN=$CT_HOSTNAME" -addext "subjectAltName=$san" -keyout "$CT_ETC/tls.key" -out "$CT_ETC/tls.crt"
  else
    info "issuing the server's TLS certificate for $LISTEN, signed by the Proxmox CA"
    run pct exec "$CTID" -- openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
      -subj "/CN=$CT_HOSTNAME" -keyout "$CT_ETC/tls.key" -out /root/pvewarden-tls.csr
    if [ "$DRY_RUN" = 1 ]; then
      echo "would sign the request with $PVE_CA_KEY (subjectAltName $san, 825 days)"
    else
      pct pull "$CTID" /root/pvewarden-tls.csr "$WORK/tls.csr"
      printf 'basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=serverAuth\nsubjectAltName=%s\n' \
        "$san" > "$WORK/tls.ext"
      openssl x509 -req -in "$WORK/tls.csr" -CA "$PVE_ETC/pve-root-ca.pem" -CAkey "$PVE_CA_KEY" \
        -set_serial "0x$(openssl rand -hex 16)" -days 825 -sha256 -extfile "$WORK/tls.ext" -out "$WORK/tls.crt" 2>/dev/null ||
        die "signing the certificate with the Proxmox CA failed"
      ct_push "$WORK/tls.crt" "$CT_ETC/tls.crt" 0644
      pct exec "$CTID" -- rm -f /root/pvewarden-tls.csr
    fi
    ct_push "$PVE_ETC/pve-root-ca.pem" "$CT_ETC/tls-ca.pem" 0644
  fi
  run pct exec "$CTID" -- sh -c "chown root:pvewarden $CT_ETC/tls.key && chmod 0640 $CT_ETC/tls.key && chmod 0644 $CT_ETC/tls.crt"
  # self-signed: the certificate is its own CA
  [ -r "$PVE_CA_KEY" ] || [ "$DRY_RUN" = 1 ] || pct exec "$CTID" -- install -m 0644 "$CT_ETC/tls.crt" "$CT_ETC/tls-ca.pem"
  # installs from before tls_ca: add it, so the server offers /ca.pem
  run pct exec "$CTID" -- sh -c "grep -q '^tls_ca' $CT_ETC/config.toml || sed -i '/^tls_key/a tls_ca = \"$CT_ETC/tls-ca.pem\"' $CT_ETC/config.toml"
}

# tls_kind: how the installed server is reached: http, pve-ca or self-signed
tls_kind() {
  if ! pct exec "$CTID" -- test -f "$CT_ETC/tls.crt"; then
    echo http
  elif pct exec "$CTID" -- cat "$CT_ETC/tls.crt" | openssl verify -CAfile "$PVE_ETC/pve-root-ca.pem" >/dev/null 2>&1; then
    echo pve-ca
  else
    echo self-signed
  fi
}


SETUP_PROBLEMS=""
start_server() {
  info "starting the pvewarden service"
  slow pct exec "$CTID" -- systemctl restart pvewarden
  info "checking the setup (pvewarden doctor)"
  slow pct exec "$CTID" -- runuser -u pvewarden -- /usr/local/bin/pvewarden doctor || SETUP_PROBLEMS="doctor reported failures (see above)"
  [ "$DRY_RUN" = 1 ] && return 0
  sleep 2
  if ! pct exec "$CTID" -- systemctl is-active --quiet pvewarden; then
    SETUP_PROBLEMS="${SETUP_PROBLEMS:+$SETUP_PROBLEMS; }the service is not running (pct exec $CTID -- journalctl -u pvewarden -n 30)"
  fi
}

install_enroll_tool() {
  info "installing pvewarden-enroll on this host"
  run mkdir -p "$HOST_DIR" "$ETC"
  run rm -rf "$HOST_DIR/guest" "$HOST_DIR/proxmox"
  run cp -r "$WORK/src/guest" "$WORK/src/proxmox" "$HOST_DIR/"
  run ln -sf "$HOST_DIR/proxmox/pvewarden-enroll" "$SBIN/pvewarden-enroll"
  run ln -sf "$HOST_DIR/proxmox/pvewarden-setup" "$SBIN/pvewarden-setup"
  write_enroll_conf
}

# enroll.conf: where pvewarden-enroll finds the server (it makes each guest's key there)
write_enroll_conf() {
  if [ "$DRY_RUN" = 1 ]; then
    echo "would write $ETC/enroll.conf: SERVER_CT=$CTID FROM=$CT_IP POOL=$POOL"
  else
    printf '# written by pvewarden-setup %s\nSERVER_CT=%q\nFROM=%q\nPOOL=%q\n' "$VERSION" "$CTID" "$CT_IP" "$POOL" \
      > "$ETC/enroll.conf"
  fi
}

# ca_hash: SHA-256 of the CA file the server offers at /ca.pem (what clients check)
ca_hash() { pct exec "$CTID" -- cat "$CT_ETC/tls-ca.pem" 2>/dev/null | sha256sum | cut -c1-64; }

# trust_commands BASE_URL HASH: paste-ready commands that fetch /ca.pem, check its fingerprint
# and point NODE_EXTRA_CA_CERTS at it. -k is fine: the fingerprint check is what makes it safe.
# They leave a NODE_EXTRA_CA_CERTS alone that points to some other file.
trust_commands() {
  printf ' %sPowerShell%s (in cmd, type powershell first):\n\n' "$C_BOLD" "$C_OFF"
  sed "s|@URL@|$1/ca.pem|g; s|@HASH@|$2|g" <<'EOF'
$p="$HOME\pvewarden-ca.pem"; curl.exe -sk @URL@ -o $p; if (-not (Test-Path $p)) { "cannot reach @URL@" } elseif ((Get-FileHash $p).Hash -ne "@HASH@") { Remove-Item $p; "WRONG CERTIFICATE - not trusted" } elseif ($env:NODE_EXTRA_CA_CERTS -and -not (Split-Path -Leaf $env:NODE_EXTRA_CA_CERTS).StartsWith("pvewarden")) { "NODE_EXTRA_CA_CERTS is in use: add $p to $env:NODE_EXTRA_CA_CERTS" } else { setx NODE_EXTRA_CA_CERTS $p; "OK - open a new terminal" }
EOF
  printf '\n %sLinux / macOS:%s\n\n' "$C_BOLD" "$C_OFF"
  sed "s|@URL@|$1/ca.pem|g; s|@HASH@|$2|g" <<'EOF'
p=~/pvewarden-ca.pem; curl -fsk @URL@ -o "$p" || echo "cannot reach @URL@"; if [ "$(openssl dgst -sha256 -r "$p" 2>/dev/null | cut -c1-64)" != "@HASH@" ]; then rm -f "$p"; echo "WRONG CERTIFICATE - not trusted"; elif [ -n "${NODE_EXTRA_CA_CERTS:-}" ] && [ "${NODE_EXTRA_CA_CERTS##*/pvewarden}" = "$NODE_EXTRA_CA_CERTS" ]; then echo "NODE_EXTRA_CA_CERTS is in use: add $p to $NODE_EXTRA_CA_CERTS"; else for f in ~/.bashrc ~/.zshrc; do [ -f "$f" ] && ! grep -qs "NODE_EXTRA_CA_CERTS=$p" "$f" && echo "export NODE_EXTRA_CA_CERTS=$p" >> "$f"; done; echo "OK - open a new terminal"; fi
EOF
}

# connection_fields URL TOKEN: what any MCP client needs; TOKEN may be a placeholder
connection_fields() {
  field "MCP server" "$1"
  field "Header" "Authorization: Bearer $2"
}

# connect_steps URL TOKEN: numbered steps to connect an agent; TOKEN may be a placeholder
connect_steps() {
  local url=$1 token=$2
  if [ "${url%%:*}" = https ]; then
    section "1. Trust the server's certificate (once per computer)"
    echo " Downloads the CA, checks its fingerprint and sets NODE_EXTRA_CA_CERTS for"
    echo " Node-based agents such as Claude Code. Other runtimes: docs/clients.md"
    echo
    trust_commands "${url%/mcp}" "$(ca_hash)"
  else
    section "1. Plain HTTP: nothing to trust"
    echo " Use it only inside a network you trust (VPN, LAN)."
  fi
  section "2. Add the server to your agent"
  echo " Any MCP client: add a remote MCP server (streamable HTTP) with the address"
  echo " and header above. Examples for other clients: docs/clients.md"
  echo
  printf ' %sClaude Code:%s\n\n' "$C_BOLD" "$C_OFF"
  claude_add "$url" "$token"
  section "3. Restart the agent and ask: \"What updates are pending?\""
}

# claude_add URL TOKEN: one line on purpose, it works the same in bash, zsh, cmd and PowerShell
claude_add() {
  echo "claude mcp add --scope user --transport http pvewarden $1 --header \"Authorization: Bearer $2\""
}

# guests_line: the guests pvewarden manages (members of its pool)
guests_line() {
  local list
  list=$(pvesh get "/pools/$POOL" --output-format json 2>/dev/null |
    json 'print join ", ", map { "$_->{vmid}" . ($_->{name} ? " $_->{name}" : "") } grep { defined $_->{vmid} } @{$d->{members}}' 2>/dev/null) || true
  echo "${list:-none yet: pvewarden-setup enroll}"
}

final_message() {
  local scheme url
  scheme=$([ "$USE_TLS" = yes ] && echo https || echo http)
  url="$scheme://$LISTEN:8765/mcp"
  if [ "$DRY_RUN" = 1 ]; then
    printf '\nDry run finished: nothing was changed. The real install ends with the MCP endpoint\n'
    printf '(%s) and a one-time agent token.\n' "$url"
    return 0
  fi
  if [ -n "$SETUP_PROBLEMS" ]; then
    banner "${C_BAD}pvewarden is installed, but NOT working yet${C_OFF}"
    echo
    field "Problem" "$SETUP_PROBLEMS"
    field "Then" "pct exec $CTID -- runuser -u pvewarden -- /usr/local/bin/pvewarden doctor"
  else
    banner "${C_OK}pvewarden is ready${C_OFF}"
  fi
  echo
  connection_fields "$url" "$AGENT_TOKEN"
  field "Guests" "$(guests_line)"
  field "Checks" "$([ -n "$SETUP_PROBLEMS" ] && echo "${C_BAD}problems, see above${C_OFF}" || echo "${C_OK}all OK${C_OFF}")"
  connect_steps "$url" "$AGENT_TOKEN"
  echo " ${C_KEY}The token is shown only now.${C_OFF} A new one: pvewarden-setup token"
  echo " These steps again, without the token: pvewarden-setup connect"
  line '='
}

do_install() {
  load_state
  if [ -n "$CTID" ] && pct status "$CTID" >/dev/null 2>&1; then
    die "pvewarden is already installed in container $CTID: use 'pvewarden-setup upgrade' or 'uninstall'"
  fi
  fetch_source
  ask_container
  ask_access
  check_name_collisions
  confirm "Please review:\n\n$(summary)\n\nProceed?" || die "cancelled"
  [ "$YES" = 1 ] && summary
  ensure_template
  create_container
  wait_for_network
  ensure_proxmox_access
  create_token
  api_endpoint
  install_server
  write_server_config
  save_state
  install_enroll_tool
  CREATED_CT="" # installed: nothing left half-done
  # enroll before the check and the summary: doctor then sees the guests, and the summary
  # (endpoint, token) is the last thing on screen. A subshell, so a cancel does not end the install.
  if [ "$YES" = 0 ] && [ "$DRY_RUN" = 0 ] && confirm "Enroll guests now?"; then
    (do_enroll) || echo "enrolling did not finish; run it any time: pvewarden-setup enroll"
  fi
  start_server
  final_message
}

# ============================================================================================
# enroll: choose guests and permissions
# ============================================================================================

do_enroll() {
  load_state
  [ -x "$SBIN/pvewarden-enroll" ] || [ "$DRY_RUN" = 1 ] || die "pvewarden is not installed (run install first)"
  local items=() vmid name type status chosen level tags
  while IFS=$'\t' read -r vmid name type status; do
    [ "$vmid" = "$CTID" ] && continue # never the server itself
    items+=("$vmid" "$name ($type, $status)" OFF)
  done < <(pvesh get /cluster/resources --type vm --output-format json |
    json 'printf "%s\t%s\t%s\t%s\n", $_->{vmid}, $_->{name} // "", $_->{type}, $_->{status} for sort { $a->{vmid} <=> $b->{vmid} } grep { !$_->{template} } @$d')

  if [ "$YES" = 1 ]; then
    chosen=$(env_or ENROLL "")
  else
    chosen=$(whiptail --title "$TITLE" --separate-output --checklist \
      "Guests to manage (running Ubuntu/Debian; VMs need the qemu-guest-agent):" 22 76 14 "${items[@]}" 3>&1 1>&2 2>&3) ||
      die "cancelled"
  fi
  [ -n "$chosen" ] || {
    echo "no guests selected"
    return 0
  }
  choose LEVEL "What may agents do on the selected guests?" update \
    readonly "Read only: check updates and services" \
    update "Install updates (with snapshots before)" \
    reboot "Install updates and reboot"
  # shellcheck disable=SC2153  # set by choose
  level=$LEVEL
  case "$level" in
    readonly) tags="" ;;
    update) tags=$TAG_UPDATE ;;
    reboot) tags="$TAG_UPDATE,$TAG_REBOOT" ;;
    *) die "unknown level $level" ;;
  esac
  choose AUTO_UPDATES "Automatic updates on the selected guests?\n\nA guest's own unattended-upgrades can install updates every day by itself, without a pvewarden snapshot (Ubuntu does it by default; Debian once unattended-upgrades is installed, which pvewarden needs). The client reports the result for each guest." keep \
    keep "Keep each guest's current setting" \
    off "Turn off: only pvewarden installs updates, with snapshots" \
    on "Turn on: guests also update themselves daily"
  # shellcheck disable=SC2153  # set by choose
  local args=(--pool --auto-updates "$AUTO_UPDATES")
  [ -n "$tags" ] && args+=(--tags "$tags")
  [ "$DRY_RUN" = 1 ] && args+=(--dry-run)
  # shellcheck disable=SC2086  # one VMID per word
  "$SBIN/pvewarden-enroll" "${args[@]}" $chosen
}

# ============================================================================================
# upgrade and uninstall
# ============================================================================================

do_upgrade() {
  load_state
  [ -n "$CTID" ] || die "no installation found ($SETUP_STATE is missing)"
  fetch_source
  confirm "Upgrade pvewarden in container $CTID and the tools on this host to $VERSION?" || die "cancelled"
  info "upgrading the server in container $CTID"
  run pct exec "$CTID" -- rm -rf /root/pvewarden-src
  run pct exec "$CTID" -- mkdir -p /root/pvewarden-src
  ct_push "$SRC_TAR" /root/pvewarden-src.tar.gz 0600
  run pct exec "$CTID" -- tar -C /root/pvewarden-src -xzf /root/pvewarden-src.tar.gz
  slow pct exec "$CTID" -- bash /root/pvewarden-src/deploy/install-server.sh "$LISTEN"
  info "restarting the pvewarden service"
  slow pct exec "$CTID" -- systemctl restart pvewarden
  CT_IP=${CT_IP:-$LISTEN}
  [ -f "$OWNED" ] || legacy_ownership
  install_enroll_tool_keep_conf
  save_state
  if confirm "Enroll every guest in pool $POOL again (pvewarden-enroll --all)?\n\nThis updates the client on the guests and gives each guest its own SSH key. Since 0.1.2 the server refuses guests that have no key of their own, so say yes unless you will run pvewarden-enroll yourself."; then
    if run "$SBIN/pvewarden-enroll" --all; then
      remove_shared_key
    else
      echo "some guests were not switched: the server refuses them until they are enrolled again (pvewarden-enroll <vmid>)"
    fi
  else
    echo "guests are refused until they are enrolled again: pvewarden-enroll --all"
  fi
  start_server
}

install_enroll_tool_keep_conf() {
  run rm -rf "$HOST_DIR/guest" "$HOST_DIR/proxmox"
  run mkdir -p "$HOST_DIR"
  run cp -r "$WORK/src/guest" "$WORK/src/proxmox" "$HOST_DIR/"
  # before 0.1.2: a shared key (PUBKEY) instead of the server (SERVER_CT); keep FROM and POOL as set
  if [ -f "$ETC/enroll.conf" ] && ! grep -q '^SERVER_CT=' "$ETC/enroll.conf"; then
    if [ "$DRY_RUN" = 1 ]; then
      echo "would add SERVER_CT=$CTID to $ETC/enroll.conf and drop PUBKEY"
    else
      sed -i '/^PUBKEY=/d' "$ETC/enroll.conf"
      printf 'SERVER_CT=%q\n' "$CTID" >> "$ETC/enroll.conf"
    fi
  elif [ ! -f "$ETC/enroll.conf" ]; then
    write_enroll_conf
  fi
}

# remove_shared_key: once every guest has its own key, the old shared key (before 0.1.2) is unused
remove_shared_key() {
  pct exec "$CTID" -- test -f "$CT_ETC/id_ed25519" 2>/dev/null || [ "$DRY_RUN" = 1 ] || return 0
  info "every guest has its own key now: removing the old shared SSH key from the server"
  run pct exec "$CTID" -- sed -i '/^key = /d' "$CT_ETC/config.toml"
  run pct exec "$CTID" -- rm -f "$CT_ETC/id_ed25519" "$CT_ETC/id_ed25519.pub"
}

do_uninstall() {
  load_state
  confirm "Remove pvewarden?\n\n- the client from every guest in pool $POOL\n- token, user $PVE_USER, role $ROLE and pool $POOL\n- the tools on this host\n\nGuest tags are left in place. The container is removed only if you confirm it next." ||
    die "cancelled"
  if [ -x "$SBIN/pvewarden-enroll" ] && pvesh get "/pools/$POOL" >/dev/null 2>&1; then
    info "removing the client from the guests in pool $POOL"
    run "$SBIN/pvewarden-enroll" --uninstall --all || true
  fi
  info "removing Proxmox user $PVE_USER (and its token), role $ROLE and pool $POOL"
  if user_exists; then
    if owns USER; then
      run pveum user delete "$PVE_USER"
    else
      # the token is always pvewarden's own: a credential must not outlive the install
      if pvesh get "/access/users/$PVE_USER/token/$TOKEN_NAME" >/dev/null 2>&1; then
        run pveum user token remove "$PVE_USER" "$TOKEN_NAME"
      fi
      echo "user $PVE_USER left alone (not recorded as created by pvewarden-setup); pvewarden's token $TOKEN_NAME on it is removed. If it is not used elsewhere: pveum user delete $PVE_USER"
    fi
  fi
  if role_exists; then
    if owns ROLE; then run pveum role delete "$ROLE"; else echo "role $ROLE left alone (not recorded as created by pvewarden-setup). If it is not used elsewhere: pveum role delete $ROLE"; fi
  fi
  if pool_exists && ! owns POOL; then
    echo "pool $POOL left alone (not recorded as created by pvewarden-setup). If it is not used elsewhere: pveum pool delete $POOL"
  elif pool_exists; then
    # a pool must be empty before it can be deleted; guests stay, only the membership goes
    local members
    members=$(pvesh get "/pools/$POOL" --output-format json | json 'print join ",", map { $_->{vmid} } grep { defined $_->{vmid} } @{$d->{members}}')
    [ -n "$members" ] && run pveum pool modify "$POOL" --vms "$members" --delete 1
    run pveum pool delete "$POOL"
  fi
  if [ -n "$CTID" ] && pct status "$CTID" >/dev/null 2>&1; then
    if [ "$YES" = 0 ] && whiptail --title "$TITLE" --defaultno --yesno "Also destroy container $CTID (the server, its audit log and keys)?" 10 76; then
      info "stopping and destroying container $CTID"
      slow pct stop "$CTID" || true
      slow pct destroy "$CTID" --purge 1
    elif [ "$(env_or DESTROY_CT no)" = yes ]; then
      info "stopping and destroying container $CTID"
      slow pct stop "$CTID" || true
      slow pct destroy "$CTID" --purge 1
    else
      echo "container $CTID was kept"
    fi
  fi
  info "removing the tools from this host"
  run rm -rf "$HOST_DIR" "$ETC" "$SBIN/pvewarden-enroll" "$SBIN/pvewarden-setup" # incl. $OWNED
  echo "pvewarden removed"
}

# ============================================================================================

# ============================================================================================
# token: rotate an agent's token
# ============================================================================================

do_token() {
  load_state
  [ -n "$CTID" ] || die "no installation found ($SETUP_STATE is missing)"
  local client token
  ask CLIENT "Which agent gets a new token? (client name in the server config)" agent
  # shellcheck disable=SC2153  # set by ask
  client=$CLIENT
  case "$client" in "" | *[!A-Za-z0-9_-]*) die "client name may contain letters, digits, '-' and '_'" ;; esac
  confirm "Give '$client' a new token?\n\nThe old token stops working immediately: update it in every MCP client that uses it." ||
    die "cancelled"
  if [ "$DRY_RUN" = 1 ]; then
    echo "would run: pct exec $CTID -- /usr/local/bin/pvewarden token $client"
    echo "would run: pct exec $CTID -- systemctl restart pvewarden"
    return 0
  fi
  # generated inside the container: the token appears only in this output, never in a command line
  info "generating a new token in container $CTID"
  token=$(slow pct exec "$CTID" -- /usr/local/bin/pvewarden token "$client" 2>/dev/null) ||
    die "could not set the token (is pvewarden in container $CTID up to date? run: pvewarden-setup upgrade)"
  info "restarting the pvewarden service"
  slow pct exec "$CTID" -- systemctl restart pvewarden
  local url kind
  kind=$(tls_kind)
  url="$([ "$kind" = http ] && echo http || echo https)://$LISTEN:8765/mcp"
  banner "${C_OK}New token for '$client'${C_OFF}"
  echo
  connection_fields "$url" "$token"
  echo
  echo " ${C_KEY}The token is shown only now.${C_OFF} The old one no longer works."
  section "Replace the token in every agent that uses it"
  echo " Any MCP client: put the new header into its pvewarden server settings and"
  echo " restart it. Examples for other clients: docs/clients.md"
  echo
  printf ' %sClaude Code:%s\n\n' "$C_BOLD" "$C_OFF"
  echo "claude mcp remove --scope user pvewarden"
  claude_add "$url" "$token"
  line '='
}

# ============================================================================================
# renew-cert: a new TLS certificate for the server
# ============================================================================================

do_renew_cert() {
  load_state
  [ -n "$CTID" ] || die "no installation found ($SETUP_STATE is missing)"
  pct exec "$CTID" -- test -f "$CT_ETC/tls.crt" || die "this installation uses plain HTTP: there is no certificate"
  confirm "Issue a new TLS certificate for $LISTEN, signed by the Proxmox CA?\n\nClients that trust the Proxmox CA (pve-root-ca.pem) need nothing new. Clients that trusted the old self-signed certificate must switch to the Proxmox CA." ||
    die "cancelled"
  issue_tls_cert
  info "restarting the pvewarden service"
  slow pct exec "$CTID" -- systemctl restart pvewarden
  [ "$DRY_RUN" = 1 ] && return 0
  printf '\nNew certificate for %s (%s).\n' "$LISTEN" "$(tls_kind)"
  echo "Computers that already trust the Proxmox CA need nothing new. Others: pvewarden-setup connect"
}

# ============================================================================================
# connect: show how to connect an agent again (the token itself is not shown)
# ============================================================================================

do_connect() {
  load_state
  [ -n "$CTID" ] || die "no installation found ($SETUP_STATE is missing)"
  local url
  url="$([ "$(tls_kind)" = http ] && echo http || echo https)://$LISTEN:8765/mcp"
  banner "${C_OK}Connect an AI agent to pvewarden${C_OFF}"
  echo
  connection_fields "$url" "<token: shown at install; a new one: pvewarden-setup token>"
  connect_steps "$url" "<token>"
  line '='
}

usage() {
  sed -n '3,7s/^#  \{0,1\}//p' "$0"
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    install | upgrade | enroll | connect | token | uninstall) COMMAND=$1 ;;
    renew-cert) COMMAND=renew_cert ;;
    --yes | -y) YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --source)
      SOURCE=${2:?--source needs a path}
      shift
      ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
  shift
done

preflight
if [ -z "$COMMAND" ]; then
  [ "$YES" = 0 ] || die "give a command with --yes"
  load_state
  if [ -n "$CTID" ]; then default=enroll; else default=install; fi
  choose COMMAND "What do you want to do?" "$default" \
    install "Install pvewarden" \
    enroll "Let pvewarden manage more guests" \
    upgrade "Upgrade an existing installation" \
    connect "Show how to connect an agent" \
    token "Give an agent a new token (the old one stops working)" \
    renew_cert "New TLS certificate (e.g. after the server's address changed)" \
    uninstall "Remove pvewarden"
fi
"do_$COMMAND"
