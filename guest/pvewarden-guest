#!/bin/bash
# /usr/local/sbin/pvewarden-guest — privileged worker. The pvewarden user may run exactly
# the commands below as root (see /etc/sudoers.d/pvewarden); nothing else.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o DPkg::Lock::Timeout=300)

# Official archives per distribution, as unattended-upgrade Origins-Pattern entries.
# ${distro_codename} is expanded by unattended-upgrade, not by bash.
# shellcheck source=/dev/null
. /etc/os-release
# shellcheck disable=SC2016
case "$ID" in
  ubuntu)
    SECURITY=(
      'origin=Ubuntu,archive=${distro_codename}-security'
      'origin=UbuntuESMApps,archive=${distro_codename}-apps-security'
      'origin=UbuntuESM,archive=${distro_codename}-infra-security'
    )
    REGULAR=(
      'origin=Ubuntu,archive=${distro_codename}'
      'origin=Ubuntu,archive=${distro_codename}-updates'
    )
    ;;
  debian)
    SECURITY=(
      'origin=Debian,codename=${distro_codename}-security,label=Debian-Security'
      'origin=Debian,codename=${distro_codename},label=Debian-Security'
    )
    # point releases land in the release itself; -updates carries stable-updates
    REGULAR=(
      'origin=Debian,codename=${distro_codename},label=Debian'
      'origin=Debian,codename=${distro_codename}-updates,label=Debian'
    )
    ;;
  *)
    echo "unsupported distribution: $ID" >&2
    exit 3
    ;;
esac

# Run unattended-upgrade allowed to install only from the given official origins.
# Origins configured on the guest itself (e.g. third-party repos) are cleared for this run.
upgrade_from() {
  local dir rc=0
  dir=$(mktemp -d)
  printf 'Dir::Etc::main "%s/main.conf";\n' "$dir" > "$dir/apt.conf"
  {
    echo '#clear Unattended-Upgrade::Allowed-Origins;'
    echo '#clear Unattended-Upgrade::Origins-Pattern;'
    echo 'Unattended-Upgrade::Origins-Pattern {'
    printf '  "%s";\n' "$@"
    echo '};'
  } > "$dir/main.conf"
  APT_CONFIG="$dir/apt.conf" unattended-upgrade -v || rc=$?
  rm -rf "$dir"
  return $rc
}

# --- updates run detached ----------------------------------------------------------------
# An update must not die halfway through dpkg because the SSH connection dropped or the server
# stopped waiting. So upgrade-* starts the real work as its own process (a transient systemd unit
# where systemd runs, else a new session) and only follows its output. upgrade-follow attaches
# again later and ends with the same exit status.
RUN_DIR=/var/lib/pvewarden
LOG=$RUN_DIR/upgrade.log RC=$RUN_DIR/upgrade.rc PIDF=$RUN_DIR/upgrade.pid LOCK=$RUN_DIR/upgrade.lock
RUN_ID=$RUN_DIR/upgrade.id # names the current run; the server checks a result belongs to its run
SELF=$(readlink -f "$0")

running() { [ -e "$LOCK" ] && ! flock -n "$LOCK" true; }

# follow: print the run's id, then its output from the start until it ends; exit with its status
follow() {
  local pid=""
  if [ -s "$RUN_ID" ]; then echo "pvewarden-run: $(cat "$RUN_ID")"; fi
  for _ in $(seq 50); do  # the run writes its pid right after it starts
    pid=$(cat "$PIDF" 2>/dev/null) || true
    if [ -n "$pid" ] || [ -e "$RC" ]; then break; fi
    sleep 0.2
  done
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    tail -n +1 -f --pid="$pid" "$LOG"
  else
    cat "$LOG" 2>/dev/null || true
  fi
  if [ -s "$RC" ]; then exit "$(cat "$RC")"; fi
  echo "pvewarden: the update process ended without reporting a result" >&2
  exit 1
}

start_upgrade() {
  install -d -m 0700 "$RUN_DIR"
  if running; then
    echo "pvewarden: an update is already running on this guest; follow it with upgrade-follow" >&2
    exit 75
  fi
  rm -f "$RC" "$PIDF"
  : > "$LOG"
  echo "$(date +%s)-$$-$RANDOM$RANDOM" > "$RUN_ID"
  if [ -d /run/systemd/system ] && command -v systemd-run >/dev/null; then
    systemd-run --quiet --collect --unit="pvewarden-upgrade-$(date +%s)" \
      --description="pvewarden: $1" "$SELF" run "$1" >/dev/null
  else
    setsid -f "$SELF" run "$1" </dev/null >/dev/null 2>&1
  fi
  follow
}

case "${1:-}" in
  run)
    # internal: the detached update itself (started by start_upgrade, never over SSH)
    [ "${2:-}" = upgrade-security ] || [ "${2:-}" = upgrade-all ] || exit 2
    exec 9>"$LOCK"
    flock -n 9 || exit 75
    echo $$ > "$PIDF"
    rc=0
    "$SELF" "now-$2" >> "$LOG" 2>&1 || rc=$?
    echo "$rc" > "$RC"
    rm -f "$PIDF"
    ;;
  upgrade-security | upgrade-all)
    start_upgrade "$1"
    ;;
  upgrade-follow)
    if [ ! -e "$LOG" ]; then
      echo "pvewarden: no update has run on this guest yet" >&2
      exit 4
    fi
    follow
    ;;
  check)
    # one line per upgradable package: name, installed, candidate, origin:archive list, held
    apt-get update -qq "${APT_OPTS[@]}" >/dev/null
    python3 - <<'PY'
import apt, apt_pkg
for p in apt.Cache():
    if not p.is_upgradable:
        continue
    origins = ",".join(sorted({f"{o.origin}:{o.archive}" for o in p.candidate.origins}))
    held = "held" if p._pkg.selected_state == apt_pkg.SELSTATE_HOLD else "-"
    print("\t".join([p.name, p.installed.version, p.candidate.version, origins, held]))
PY
    ;;
  status)
    echo "os=$PRETTY_NAME"
    echo "kernel=$(uname -r)"
    echo "uptime_s=$(cut -d' ' -f1 /proc/uptime)"
    if [ -f /var/run/reboot-required ]; then echo "reboot_required=yes"; else echo "reboot_required=no"; fi
    [ -f /var/run/reboot-required.pkgs ] && sed 's/^/reboot_pkg=/' /var/run/reboot-required.pkgs
    # does the guest's own daily unattended-upgrades run install updates (without a pvewarden snapshot)?
    au=0
    eval "$(apt-config shell au APT::Periodic::Unattended-Upgrade)"
    case "$au" in "" | 0) echo "auto_updates=no" ;; *) echo "auto_updates=yes" ;; esac
    true
    ;;
  now-upgrade-security)
    apt-get update -qq "${APT_OPTS[@]}"
    upgrade_from "${SECURITY[@]}"
    ;;
  now-upgrade-all)
    apt-get update -qq "${APT_OPTS[@]}"
    upgrade_from "${SECURITY[@]}" "${REGULAR[@]}"
    ;;
  *)
    echo "usage: pvewarden-guest check|status|upgrade-security|upgrade-all|upgrade-follow" >&2
    exit 2
    ;;
esac
